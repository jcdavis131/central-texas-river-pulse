# ---- Veil server configuration ----
# Copy to .env and fill in. Everything is optional except where noted; unset
# provider blocks simply run in dormant mode (aliases/cards generated locally,
# no external routing).

# HTTP API
PORT=8787
VEIL_DB=./data/veil.db
# Comma-separated CORS allow-list (your web client origin)
VEIL_CORS=http://localhost:5180

# The domain your alias addresses live on. Point this domain's MX record at the
# inbound SMTP listener below for real mail to arrive.
VEIL_ALIAS_DOMAIN=relay.example.com

# ---- Inbound SMTP (receives mail for @VEIL_ALIAS_DOMAIN) ----
VEIL_SMTP_INBOUND=false
VEIL_SMTP_HOST=0.0.0.0
VEIL_SMTP_PORT=2525

# ---- Email forwarding (outbound relay to the user's real inbox) ----
VEIL_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=no-reply@relay.example.com

# ---- Phone masking (Twilio) ----
VEIL_TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Virtual cards (Stripe Issuing) ----
VEIL_STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_CARDHOLDER_ID=
